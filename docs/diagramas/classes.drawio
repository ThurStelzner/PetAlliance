<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" type="device"><diagram id="petalliance-classes" name="Diagrama de Classes"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="PetAlliance - Diagrama de Classes (backEnd\models + DAOs)" style="text;html=1;fontSize=18;fontStyle=1;align=center;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="Usuario" value="&lt;div style=&quot;text-align:center;font-weight:bold;padding-top:4px;padding-left:4px;padding-right:4px;&quot;&gt;Model: Usuario (implements JsonSerializable)&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;&quot;&gt;- id : int&lt;br/&gt;- cpf : String(11)&lt;br/&gt;- cep : String(8)&lt;br/&gt;- nome : String(100)&lt;br/&gt;- email : String(100)&lt;br/&gt;- senha : String(255)&lt;br/&gt;- tipo : int&lt;br/&gt;- imagem : String (foto_perfil)&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;padding-bottom:4px;&quot;&gt;+ __construct()&lt;br/&gt;+ jsonSerialize()&lt;br/&gt;+ getters / setters&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="260" height="181" as="geometry"/></mxCell><mxCell id="Animal" value="&lt;div style=&quot;text-align:center;font-weight:bold;padding-top:4px;padding-left:4px;padding-right:4px;&quot;&gt;Model: Animal (implements Json)&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;&quot;&gt;- id : int&lt;br/&gt;- dono_id : int (FK tb_usuarios)&lt;br/&gt;- nome : String(50)&lt;br/&gt;- raca : String(50)&lt;br/&gt;- cor : String(30)&lt;br/&gt;- sexo/tipo/porte : String&lt;br/&gt;- data_nascimento : Date&lt;br/&gt;- peso : Decimal(5,2)&lt;br/&gt;- vacinado : bool&lt;br/&gt;- foto_vacinas : String(250)&lt;br/&gt;- foto_certificado : String(250)&lt;br/&gt;- venda_preco : Decimal(10,2)&lt;br/&gt;- favoritado : bool + fotos[]&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;padding-bottom:4px;&quot;&gt;+ __construct()&lt;br/&gt;+ jsonSerialize()&lt;br/&gt;+ getters / setters&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="330" y="120" width="260" height="246" as="geometry"/></mxCell><mxCell id="SolicitacaoMatch" value="&lt;div style=&quot;text-align:center;font-weight:bold;padding-top:4px;padding-left:4px;padding-right:4px;&quot;&gt;Model: SolicitacaoMatch (implements Json)&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;&quot;&gt;- id : int&lt;br/&gt;- pet_id : int (FK tb_pets)&lt;br/&gt;- remetente_id : int (FK tb_usuarios)&lt;br/&gt;- status : pendente/aceito/recusado&lt;br/&gt;- criado_em : Timestamp&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;padding-bottom:4px;&quot;&gt;+ __construct()&lt;br/&gt;+ jsonSerialize()&lt;br/&gt;+ setStatus() valida enum&lt;br/&gt;+ getters&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="260" height="155" as="geometry"/></mxCell><mxCell id="Conversa" value="&lt;div style=&quot;text-align:center;font-weight:bold;padding-top:4px;padding-left:4px;padding-right:4px;&quot;&gt;Conversa (via ConversaDAO)&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;&quot;&gt;- id : int&lt;br/&gt;- solicitacao_id : int (FK)&lt;br/&gt;- ativa : bool&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;padding-bottom:4px;&quot;&gt;(persistida via ConversaDAO)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="910" y="120" width="260" height="90" as="geometry"/></mxCell><mxCell id="Mensagem" value="&lt;div style=&quot;text-align:center;font-weight:bold;padding-top:4px;padding-left:4px;padding-right:4px;&quot;&gt;Model: Mensagem (implements Json)&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;&quot;&gt;- id : int&lt;br/&gt;- conversa_id : int (FK)&lt;br/&gt;- remetente_id : int (FK)&lt;br/&gt;- conteudo : String(500)&lt;br/&gt;- lida : tinyint(1)&lt;br/&gt;- data_envio : Timestamp&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;padding-bottom:4px;&quot;&gt;+ __construct()&lt;br/&gt;+ jsonSerialize()&lt;br/&gt;+ getters / setters&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1200" y="120" width="260" height="155" as="geometry"/></mxCell><mxCell id="UsuarioDAO" value="&lt;div style=&quot;text-align:center;font-weight:bold;padding-top:4px;padding-left:4px;padding-right:4px;&quot;&gt;DAO: UsuarioDAO&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;&quot;&gt;- pdo : PDO&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;padding-bottom:4px;&quot;&gt;+ read($cpf)&lt;br/&gt;+ readPorId($id)&lt;br/&gt;+ cadastrarUsuario(Usuario)&lt;br/&gt;+ updateFoto(Usuario)&lt;br/&gt;+ updateUsuario(Usuario)&lt;br/&gt;+ updateSenha($id, $senha)&lt;br/&gt;+ marcarVerificado($id)&lt;br/&gt;+ salvarEmailPendente(...)&lt;br/&gt;+ confirmarEmailPendente($token)&lt;br/&gt;+ buscarPorEmail($email)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="260" height="181" as="geometry"/></mxCell><mxCell id="AnimalDAO" value="&lt;div style=&quot;text-align:center;font-weight:bold;padding-top:4px;padding-left:4px;padding-right:4px;&quot;&gt;DAO: AnimalDAO&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;&quot;&gt;- pdo : PDO&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;padding-bottom:4px;&quot;&gt;+ carregarFotos($petId)&lt;br/&gt;+ cadastrarAnimal(Animal)&lt;br/&gt;+ read($id, $usuarioId)&lt;br/&gt;+ search(termo, filtros, pagina)&lt;br/&gt;+ readAll($usuarioId, $pagina)&lt;br/&gt;+ readByDonoId($donoId)&lt;br/&gt;+ favoritarAnimal($usuarioId, $petId)&lt;br/&gt;+ listarFavoritos($id)&lt;br/&gt;+ adicionarFoto / removerFoto&lt;br/&gt;+ atualizarAnimal(Animal)&lt;br/&gt;+ delete($id)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="330" y="430" width="260" height="194" as="geometry"/></mxCell><mxCell id="SolicitacaoMatchDAO" value="&lt;div style=&quot;text-align:center;font-weight:bold;padding-top:4px;padding-left:4px;padding-right:4px;&quot;&gt;DAO: SolicitacaoMatchDAO&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;&quot;&gt;- pdo : PDO&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;padding-bottom:4px;&quot;&gt;+ criar(SolicitacaoMatch)&lt;br/&gt;+ listarPorDono($donoId)&lt;br/&gt;+ listarPorRemetente($remetenteId)&lt;br/&gt;+ atualizarStatus($id, $status)&lt;br/&gt;+ buscar($id)&lt;br/&gt;+ verificarExistente($petId, $remId)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="620" y="430" width="260" height="129" as="geometry"/></mxCell><mxCell id="ConversaDAO" value="&lt;div style=&quot;text-align:center;font-weight:bold;padding-top:4px;padding-left:4px;padding-right:4px;&quot;&gt;DAO: ConversaDAO&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;&quot;&gt;- pdo : PDO&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;padding-bottom:4px;&quot;&gt;+ criar($solicitacaoId)&lt;br/&gt;+ buscar($id)&lt;br/&gt;+ buscarPorSolicitacao($id)&lt;br/&gt;+ listarPorUsuario($usuarioId)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="910" y="430" width="260" height="103" as="geometry"/></mxCell><mxCell id="MensagemDAO" value="&lt;div style=&quot;text-align:center;font-weight:bold;padding-top:4px;padding-left:4px;padding-right:4px;&quot;&gt;DAO: MensagemDAO&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;&quot;&gt;- pdo : PDO&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;padding-bottom:4px;&quot;&gt;+ enviar(Mensagem)&lt;br/&gt;+ listarPorConversa($convId, $limite)&lt;br/&gt;+ novasDesde($convId, $ultimoId)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1200" y="430" width="260" height="90" as="geometry"/></mxCell><mxCell id="Notificacao" value="&lt;div style=&quot;text-align:center;font-weight:bold;padding-top:4px;padding-left:4px;padding-right:4px;&quot;&gt;Model: Notificacao (implements Json)&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;&quot;&gt;- id : int&lt;br/&gt;- usuario_id : int (FK)&lt;br/&gt;- tipo : String(50)&lt;br/&gt;- mensagem : Text&lt;br/&gt;- lida : tinyint(1)&lt;br/&gt;- link : String(255)&lt;br/&gt;- criado_em : Timestamp&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;padding-bottom:4px;&quot;&gt;+ __construct()&lt;br/&gt;+ jsonSerialize()&lt;br/&gt;+ getters&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="260" height="168" as="geometry"/></mxCell><mxCell id="Denuncia" value="&lt;div style=&quot;text-align:center;font-weight:bold;padding-top:4px;padding-left:4px;padding-right:4px;&quot;&gt;Model: Denuncia&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;&quot;&gt;- id : int&lt;br/&gt;- usuario_id : int (FK)&lt;br/&gt;- tipo_alvo : animal|usuario|site&lt;br/&gt;- alvo_id : int NULL&lt;br/&gt;- descricao : Text&lt;br/&gt;- resolvido : tinyint(1)&lt;br/&gt;- criado_em : Timestamp&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;padding-bottom:4px;&quot;&gt;+ __construct()&lt;br/&gt;+ getters / setters&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="330" y="700" width="260" height="155" as="geometry"/></mxCell><mxCell id="PagamentoAbacatePay" value="&lt;div style=&quot;text-align:center;font-weight:bold;padding-top:4px;padding-left:4px;padding-right:4px;&quot;&gt;Service: PagamentoAbacatePay&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;&quot;&gt;- pdo : PDO&lt;br/&gt;- apiKey : String (via env)&lt;br/&gt;- apiUrl : String (sandbox)&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;padding-bottom:4px;&quot;&gt;+ criarCheckout(animalId, produtoId, preco, usuarioId)&lt;br/&gt;+ verificarStatusPagamento($produtoId)&lt;br/&gt;+ atualizarStatusPagamento($checkoutId, $status)&lt;br/&gt;+ webhookNotificacao()&lt;br/&gt;+ getPagamentosUsuario($usuarioId)&lt;br/&gt;+ consultarStatusApiAbacatePay($checkoutId)&lt;br/&gt;+ verificarEAtualizarPagamentoPendente(...)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="620" y="700" width="260" height="168" as="geometry"/></mxCell><mxCell id="NotificacaoDAO" value="&lt;div style=&quot;text-align:center;font-weight:bold;padding-top:4px;padding-left:4px;padding-right:4px;&quot;&gt;DAO: NotificacaoDAO&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;&quot;&gt;- pdo : PDO&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;padding-bottom:4px;&quot;&gt;+ criar(Notificacao)&lt;br/&gt;+ listarPorUsuario($usuarioId)&lt;br/&gt;+ marcarLida($id)&lt;br/&gt;+ naoLidas($usuarioId)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="910" y="700" width="260" height="103" as="geometry"/></mxCell><mxCell id="DenunciaDAO" value="&lt;div style=&quot;text-align:center;font-weight:bold;padding-top:4px;padding-left:4px;padding-right:4px;&quot;&gt;DAO: DenunciaDAO&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;&quot;&gt;- pdo : PDO&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;padding-bottom:4px;&quot;&gt;+ cadastrar(Denuncia)&lt;br/&gt;+ listar()&lt;br/&gt;+ atualizarStatus($id, $status)&lt;br/&gt;+ estatisticas()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1200" y="700" width="260" height="103" as="geometry"/></mxCell><mxCell id="EmailService" value="&lt;div style=&quot;text-align:center;font-weight:bold;padding-top:4px;padding-left:4px;padding-right:4px;&quot;&gt;Service: EmailService&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;&quot;&gt;- transport : SMTP&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;padding-bottom:4px;&quot;&gt;+ enviarVerificacao($email, $nome, $token, $codigo)&lt;br/&gt;+ enviarRecuperacao($email, $nome, $token, $codigo)&lt;br/&gt;+ enviarAlteracaoEmail($email, $nome, $token)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="260" height="90" as="geometry"/></mxCell><mxCell id="VerificacaoDAO" value="&lt;div style=&quot;text-align:center;font-weight:bold;padding-top:4px;padding-left:4px;padding-right:4px;&quot;&gt;DAO: VerificacaoDAO&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;&quot;&gt;- pdo : PDO&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;padding-bottom:4px;&quot;&gt;+ salvar($usuarioId, $token, $codigo, $exp, $tipo)&lt;br/&gt;+ buscarPorToken($token, $tipo)&lt;br/&gt;+ buscarPorUsuario($usuarioId, $tipo)&lt;br/&gt;+ buscarUltimoPorUsuario(...)&lt;br/&gt;- marcarUsado($id)&lt;br/&gt;- limparPorUsuario($usuarioId, $tipo)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="330" y="950" width="260" height="129" as="geometry"/></mxCell><mxCell id="Conexao" value="&lt;div style=&quot;text-align:center;font-weight:bold;padding-top:4px;padding-left:4px;padding-right:4px;&quot;&gt;Config: Conexao&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;&quot;&gt;+ static getConexao() : PDO&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left;padding-left:6px;padding-right:6px;font-size:10px;padding-top:2px;padding-bottom:4px;&quot;&gt;- PDO singleton (MySQL)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="620" y="950" width="260" height="80" as="geometry"/></mxCell><mxCell id="notaTabelas" value="&lt;div style=&quot;text-align:left;font-size:10px;padding:4px;&quot;&gt;Tabelas sem classe propria (SQL direto nos DAOs):
- tb_matches: id_usuario1/2, id_animal1/2, aceito
- tb_bloqueios: usuario_id, bloqueado_id
- tb_favoritos: id_pet, id_usuario (favoritar)
