FROM php:8.3-apache

# Deps de compilacao (libonig-dev e exigida pelo mbstring) + extensoes que o PetAlliance usa
RUN apt-get update && apt-get install -y \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libzip-dev \
    libonig-dev \
    unzip \
  && docker-php-ext-configure gd --with-freetype --with-jpeg \
  && docker-php-ext-install -j$(nproc) pdo pdo_mysql mysqli mbstring gd zip exif \
  && a2enmod rewrite \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN echo '<Directory /var/www/html>\n    AllowOverride All\n    Require all granted\n</Directory>' > /etc/apache2/conf-available/petalliance.conf \
  && a2enconf petalliance

WORKDIR /var/www/html
# vendor/ ja vem commitado no repo; .dockerignore tira .git/uploads/docs do contexto
COPY . .

RUN chown -R www-data:www-data /var/www/html \
  && chmod -R 755 /var/www/html \
  && mkdir -p /var/www/html/uploads/usuario /var/www/html/uploads/animais \
  && chown -R www-data:www-data /var/www/html/uploads

EXPOSE 80
