# PetAlliance - variaveis de ambiente (modelo)
# Copie este arquivo para .env e preencha os valores.
# O .env NAO e versionado (esta no .gitignore).
#
# Observacao: as credenciais do banco de dados ficam no backEnd/config/config.php
# (arquivo tambem fora do git). Sem elas, solicite o arquivo a um membro da equipe
# ou edite o config.php com as credenciais do seu MySQL local.

# --- AbacatePay (pagamentos) ---
ABACATEPAY_API_KEY=
ABACATEPAY_URL=
ABACATEPAY_PRODUCT_ID=
ABACATEPAY_PRODUCT2_ID=
ABACATEPAY_PRODUCT3_ID=
ABACATEPAY_PRODUCT4_ID=

# --- SMTP (e-mails: verificacao, redefinicao de senha) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=